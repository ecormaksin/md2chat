{
  "manifest_version": 3,
  "name": "MD2Chat",
  "version": "0.1.0",
  "description": "Type Markdown, get Slack-ready formatting — instantly, entirely in your browser. No sign-up, no data leaves your machine.",
  "action": {
    "default_title": "MD2Chat",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["sidePanel", "clipboardWrite"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
